import { NextResponse } from 'next/server';
import db from '@/lib/db';

export async function GET() {
  try {
    const categories = db.prepare('SELECT * FROM menu_categories ORDER BY display_order ASC').all() as any[];
    const items = db.prepare('SELECT * FROM menu_items ORDER BY id ASC').all() as any[];

    const structured = categories.map((cat) => ({
      ...cat,
      items: items.filter((item) => item.category_id === cat.id),
    }));

    return NextResponse.json({ categories: structured, items });
  } catch (error: any) {
    return NextResponse.json({ error: error.message }, { status: 500 });
  }
}

export async function POST(req: Request) {
  try {
    const body = await req.json();
    const { category_id, name, description, price, is_veg, is_vegan, is_gluten_free, is_bestseller, image_url, tags } = body;

    if (!name || !price || !category_id) {
      return NextResponse.json({ error: 'Missing required fields' }, { status: 400 });
    }

    const stmt = db.prepare(`
      INSERT INTO menu_items (category_id, name, description, price, is_veg, is_vegan, is_gluten_free, is_bestseller, image_url, tags)
      VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    `);

    const info = stmt.run(
      category_id,
      name,
      description || '',
      price,
      is_veg !== undefined ? is_veg : 1,
      is_vegan ? 1 : 0,
      is_gluten_free ? 1 : 0,
      is_bestseller ? 1 : 0,
      image_url || '',
      tags || ''
    );

    return NextResponse.json({ success: true, id: info.lastInsertRowid });
  } catch (error: any) {
    return NextResponse.json({ error: error.message }, { status: 500 });
  }
}

export async function DELETE(req: Request) {
  try {
    const { searchParams } = new URL(req.url);
    const id = searchParams.get('id');
    if (!id) return NextResponse.json({ error: 'Missing ID' }, { status: 400 });

    db.prepare('DELETE FROM menu_items WHERE id = ?').run(id);
    return NextResponse.json({ success: true });
  } catch (error: any) {
    return NextResponse.json({ error: error.message }, { status: 500 });
  }
}
