'use client';

import { useState, useEffect } from 'react';
import Link from 'next/link';
import { Calendar, Utensils, Image as ImageIcon, CheckCircle, XCircle, Trash2, Plus, ArrowLeft, Lock, KeyRound } from 'lucide-react';

export default function AdminDashboard() {
  const [isAuthenticated, setIsAuthenticated] = useState(false);
  const [passcode, setPasscode] = useState('');
  const [loginError, setLoginError] = useState('');

  const [activeTab, setActiveTab] = useState<'reservations' | 'menu' | 'gallery'>('reservations');
  const [reservations, setReservations] = useState<any[]>([]);
  const [categories, setCategories] = useState<any[]>([]);
  const [gallery, setGallery] = useState<any[]>([]);
  const [loading, setLoading] = useState(false);

  // New Menu Item Form state
  const [newItem, setNewItem] = useState({
    category_id: 1,
    name: '',
    description: '',
    price: '',
    image_url: '',
    tags: '',
    is_vegan: false,
    is_gluten_free: false,
  });

  // New Gallery Form state
  const [newGallery, setNewGallery] = useState({
    title: '',
    caption: '',
    image_url: '',
    category: 'ambience',
  });

  useEffect(() => {
    const stored = sessionStorage.getItem('sage_admin_auth');
    if (stored === 'true') {
      setIsAuthenticated(true);
      fetchData();
    }
  }, []);

  const handleLogin = (e: React.FormEvent) => {
    e.preventDefault();
    if (passcode === 'admin123' || passcode === 'sage2026') {
      setIsAuthenticated(true);
      sessionStorage.setItem('sage_admin_auth', 'true');
      setLoginError('');
      fetchData();
    } else {
      setLoginError('Invalid access passcode. Authorized cafe administrators only.');
    }
  };

  const handleLogout = () => {
    setIsAuthenticated(false);
    sessionStorage.removeItem('sage_admin_auth');
  };

  const fetchData = async () => {
    setLoading(true);
    try {
      const [resRes, resMenu, resGal] = await Promise.all([
        fetch('/api/reservations').then((r) => r.json()),
        fetch('/api/menu').then((r) => r.json()),
        fetch('/api/gallery').then((r) => r.json()),
      ]);

      if (resRes.reservations) setReservations(resRes.reservations);
      if (resMenu.categories) setCategories(resMenu.categories);
      if (resGal.images) setGallery(resGal.images);
    } catch (e) {
      console.error(e);
    } finally {
      setLoading(false);
    }
  };

  const handleUpdateStatus = async (id: string, status: string) => {
    await fetch('/api/reservations', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id, status }),
    });
    fetchData();
  };

  const handleAddMenuItem = async (e: React.FormEvent) => {
    e.preventDefault();
    await fetch('/api/menu', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        ...newItem,
        price: parseFloat(newItem.price) || 0,
      }),
    });
    setNewItem({
      category_id: 1,
      name: '',
      description: '',
      price: '',
      image_url: '',
      tags: '',
      is_vegan: false,
      is_gluten_free: false,
    });
    fetchData();
  };

  const handleDeleteMenuItem = async (id: number) => {
    await fetch(`/api/menu?id=${id}`, { method: 'DELETE' });
    fetchData();
  };

  const handleAddGalleryImage = async (e: React.FormEvent) => {
    e.preventDefault();
    await fetch('/api/gallery', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(newGallery),
    });
    setNewGallery({ title: '', caption: '', image_url: '', category: 'ambience' });
    fetchData();
  };

  const handleDeleteGalleryImage = async (id: number) => {
    await fetch(`/api/gallery?id=${id}`, { method: 'DELETE' });
    fetchData();
  };

  // If not authenticated, show private password gate
  if (!isAuthenticated) {
    return (
      <div className="min-h-screen bg-sage-950 flex items-center justify-center p-4">
        <div className="max-w-md w-full bg-earth-cream rounded-3xl p-8 sm:p-10 shadow-2xl border border-sage-800 text-center">
          <div className="w-14 h-14 bg-sage-800 text-earth-cream rounded-full flex items-center justify-center mx-auto mb-5 shadow-inner">
            <Lock className="w-6 h-6 text-clay-400" />
          </div>

          <h2 className="font-serif text-2xl sm:text-3xl font-bold text-sage-950">
            Staff Portal Access
          </h2>
          <p className="text-xs text-sage-600 mt-2">
            Restricted area for Sage Farm Cafe management. Please enter your administrator keycode.
          </p>

          <form onSubmit={handleLogin} className="mt-6 space-y-4">
            <div>
              <div className="relative">
                <KeyRound className="w-4 h-4 text-sage-500 absolute left-3.5 top-3.5" />
                <input
                  type="password"
                  required
                  placeholder="Enter passcode (e.g. admin123)"
                  value={passcode}
                  onChange={(e) => setPasscode(e.target.value)}
                  className="w-full bg-white border border-sage-300 rounded-xl pl-10 pr-4 py-3 text-sm text-sage-950 focus:outline-none focus:border-clay-500 shadow-inner"
                />
              </div>
              {loginError && (
                <p className="text-red-600 text-xs mt-2 text-left">{loginError}</p>
              )}
            </div>

            <button
              type="submit"
              className="w-full py-3 rounded-xl bg-sage-800 hover:bg-sage-900 text-earth-cream text-xs font-semibold uppercase tracking-wider transition-colors shadow-md"
            >
              Verify & Enter Portal
            </button>
          </form>

          <div className="mt-6 pt-4 border-t border-sage-200">
            <Link href="/" className="text-xs text-sage-600 hover:text-sage-950 transition-colors">
              ← Return to public website
            </Link>
          </div>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-earth-cream text-sage-950 flex flex-col">
      {/* Top Bar */}
      <header className="bg-sage-900 text-earth-cream py-4 px-6 shadow-md flex items-center justify-between">
        <div className="flex items-center gap-3">
          <Link href="/" className="p-2 rounded-full hover:bg-sage-800 text-sage-300 hover:text-white transition-colors">
            <ArrowLeft className="w-5 h-5" />
          </Link>
          <div>
            <h1 className="font-serif text-xl font-bold tracking-wide">Sage Farm Cafe — Owner Portal</h1>
            <p className="text-xs text-sage-400">Manage reservations, menus & real cafe imagery</p>
          </div>
        </div>
        <div className="flex items-center gap-3">
          <Link href="/" className="text-xs bg-sage-800 hover:bg-sage-700 text-earth-cream px-3.5 py-1.5 rounded-full font-medium transition-colors">
            View Live Site
          </Link>
          <button
            onClick={handleLogout}
            className="text-xs bg-clay-600 hover:bg-clay-700 text-earth-cream px-3.5 py-1.5 rounded-full font-medium transition-colors"
          >
            Lock Session
          </button>
        </div>
      </header>

      {/* Tabs */}
      <div className="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 pt-8 flex gap-4 border-b border-sage-200">
        <button
          onClick={() => setActiveTab('reservations')}
          className={`flex items-center gap-2 pb-4 px-3 text-sm font-semibold border-b-2 transition-all ${
            activeTab === 'reservations'
              ? 'border-clay-500 text-clay-700'
              : 'border-transparent text-sage-600 hover:text-sage-900'
          }`}
        >
          <Calendar className="w-4 h-4" />
          Reservations ({reservations.length})
        </button>

        <button
          onClick={() => setActiveTab('menu')}
          className={`flex items-center gap-2 pb-4 px-3 text-sm font-semibold border-b-2 transition-all ${
            activeTab === 'menu'
              ? 'border-clay-500 text-clay-700'
              : 'border-transparent text-sage-600 hover:text-sage-900'
          }`}
        >
          <Utensils className="w-4 h-4" />
          Menu Items
        </button>

        <button
          onClick={() => setActiveTab('gallery')}
          className={`flex items-center gap-2 pb-4 px-3 text-sm font-semibold border-b-2 transition-all ${
            activeTab === 'gallery'
              ? 'border-clay-500 text-clay-700'
              : 'border-transparent text-sage-600 hover:text-sage-900'
          }`}
        >
          <ImageIcon className="w-4 h-4" />
          Gallery Management ({gallery.length})
        </button>
      </div>

      {/* Content Area */}
      <main className="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 flex-1">
        {/* Reservations Tab */}
        {activeTab === 'reservations' && (
          <div className="space-y-6">
            <div className="bg-white rounded-2xl shadow-sm border border-sage-200 overflow-hidden">
              <div className="overflow-x-auto">
                <table className="w-full text-left text-sm text-sage-800">
                  <thead className="bg-sage-100/70 text-xs uppercase tracking-wider text-sage-700 font-semibold border-b border-sage-200">
                    <tr>
                      <th className="py-3 px-4">Booking ID</th>
                      <th className="py-3 px-4">Guest</th>
                      <th className="py-3 px-4">Date & Slot</th>
                      <th className="py-3 px-4">Party Size</th>
                      <th className="py-3 px-4">Area</th>
                      <th className="py-3 px-4">Status</th>
                      <th className="py-3 px-4">Action</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-sage-100">
                    {reservations.map((r) => (
                      <tr key={r.id} className="hover:bg-sage-50/60">
                        <td className="py-3 px-4 font-mono font-bold text-xs text-sage-900">{r.id}</td>
                        <td className="py-3 px-4">
                          <p className="font-semibold text-sage-950">{r.guest_name}</p>
                          <p className="text-xs text-sage-500">{r.phone} • {r.email}</p>
                        </td>
                        <td className="py-3 px-4">
                          <p className="font-medium text-sage-900">{r.date}</p>
                          <p className="text-xs text-sage-500">{r.time_slot}</p>
                        </td>
                        <td className="py-3 px-4">{r.guests_count} Guests</td>
                        <td className="py-3 px-4 text-xs font-medium text-clay-700">{r.seating_preference}</td>
                        <td className="py-3 px-4">
                          <span
                            className={`inline-block px-2.5 py-1 rounded-full text-[10px] font-bold ${
                              r.status === 'CONFIRMED'
                                ? 'bg-emerald-100 text-emerald-800'
                                : r.status === 'CANCELLED'
                                ? 'bg-red-100 text-red-800'
                                : 'bg-amber-100 text-amber-800'
                            }`}
                          >
                            {r.status}
                          </span>
                        </td>
                        <td className="py-3 px-4 flex items-center gap-2">
                          <button
                            onClick={() => handleUpdateStatus(r.id, 'CONFIRMED')}
                            title="Confirm"
                            className="p-1 rounded text-emerald-600 hover:bg-emerald-50"
                          >
                            <CheckCircle className="w-4 h-4" />
                          </button>
                          <button
                            onClick={() => handleUpdateStatus(r.id, 'CANCELLED')}
                            title="Cancel"
                            className="p-1 rounded text-red-600 hover:bg-red-50"
                          >
                            <XCircle className="w-4 h-4" />
                          </button>
                        </td>
                      </tr>
                    ))}
                    {reservations.length === 0 && (
                      <tr>
                        <td colSpan={7} className="py-8 text-center text-sm text-sage-500">
                          No reservations logged yet.
                        </td>
                      </tr>
                    )}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        )}

        {/* Menu Tab */}
        {activeTab === 'menu' && (
          <div className="grid grid-cols-1 lg:grid-cols-3 gap-8">
            {/* Add Item Form */}
            <div className="bg-white p-6 rounded-2xl border border-sage-200 shadow-sm h-fit">
              <h3 className="font-serif font-bold text-lg text-sage-950 mb-4 flex items-center gap-2">
                <Plus className="w-4 h-4 text-clay-600" /> Add New Menu Item
              </h3>
              <form onSubmit={handleAddMenuItem} className="space-y-4 text-sm">
                <div>
                  <label className="block text-xs font-semibold text-sage-700 mb-1">Category</label>
                  <select
                    value={newItem.category_id}
                    onChange={(e) => setNewItem({ ...newItem, category_id: parseInt(e.target.value) })}
                    className="w-full bg-earth-cream border border-sage-300 rounded-xl p-2.5 text-xs focus:outline-none"
                  >
                    {categories.map((c) => (
                      <option key={c.id} value={c.id}>
                        {c.name}
                      </option>
                    ))}
                  </select>
                </div>
                <div>
                  <label className="block text-xs font-semibold text-sage-700 mb-1">Dish Name</label>
                  <input
                    type="text"
                    required
                    placeholder="e.g. Wood-Fired Garden Pizza"
                    value={newItem.name}
                    onChange={(e) => setNewItem({ ...newItem, name: e.target.value })}
                    className="w-full bg-earth-cream border border-sage-300 rounded-xl p-2.5 text-xs focus:outline-none"
                  />
                </div>
                <div>
                  <label className="block text-xs font-semibold text-sage-700 mb-1">Price (₹)</label>
                  <input
                    type="number"
                    required
                    placeholder="580"
                    value={newItem.price}
                    onChange={(e) => setNewItem({ ...newItem, price: e.target.value })}
                    className="w-full bg-earth-cream border border-sage-300 rounded-xl p-2.5 text-xs focus:outline-none"
                  />
                </div>
                <div>
                  <label className="block text-xs font-semibold text-sage-700 mb-1">Image URL</label>
                  <input
                    type="url"
                    placeholder="https://images.unsplash.com/..."
                    value={newItem.image_url}
                    onChange={(e) => setNewItem({ ...newItem, image_url: e.target.value })}
                    className="w-full bg-earth-cream border border-sage-300 rounded-xl p-2.5 text-xs focus:outline-none"
                  />
                </div>
                <div>
                  <label className="block text-xs font-semibold text-sage-700 mb-1">Description</label>
                  <textarea
                    rows={2}
                    placeholder="Ingredients and culinary notes..."
                    value={newItem.description}
                    onChange={(e) => setNewItem({ ...newItem, description: e.target.value })}
                    className="w-full bg-earth-cream border border-sage-300 rounded-xl p-2.5 text-xs focus:outline-none"
                  />
                </div>
                <button
                  type="submit"
                  className="w-full py-2.5 rounded-xl bg-sage-800 hover:bg-sage-900 text-earth-cream text-xs font-semibold shadow-md transition-colors"
                >
                  Save Item to Menu
                </button>
              </form>
            </div>

            {/* Existing Menu Items List */}
            <div className="lg:col-span-2 space-y-6">
              {categories.map((cat) => (
                <div key={cat.id} className="bg-white p-6 rounded-2xl border border-sage-200 shadow-sm">
                  <h4 className="font-serif font-bold text-base text-sage-900 border-b border-sage-200 pb-2 mb-4">
                    {cat.name} ({cat.items?.length || 0})
                  </h4>
                  <div className="divide-y divide-sage-100">
                    {cat.items?.map((item: any) => (
                      <div key={item.id} className="py-3 flex items-center justify-between gap-4">
                        <div className="flex items-center gap-3">
                          {item.image_url && (
                            <img src={item.image_url} alt={item.name} className="w-12 h-12 rounded-lg object-cover bg-sage-100" />
                          )}
                          <div>
                            <p className="font-semibold text-sm text-sage-950">{item.name}</p>
                            <p className="text-xs text-sage-600 line-clamp-1">{item.description}</p>
                            <span className="text-xs font-bold text-clay-700">₹{item.price}</span>
                          </div>
                        </div>
                        <button
                          onClick={() => handleDeleteMenuItem(item.id)}
                          className="p-2 text-red-500 hover:bg-red-50 rounded-lg transition-colors"
                          title="Delete"
                        >
                          <Trash2 className="w-4 h-4" />
                        </button>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* Gallery Tab */}
        {activeTab === 'gallery' && (
          <div className="grid grid-cols-1 lg:grid-cols-3 gap-8">
            {/* Add Image Form */}
            <div className="bg-white p-6 rounded-2xl border border-sage-200 shadow-sm h-fit">
              <h3 className="font-serif font-bold text-lg text-sage-950 mb-4 flex items-center gap-2">
                <Plus className="w-4 h-4 text-clay-600" /> Upload Cafe Photo
              </h3>
              <form onSubmit={handleAddGalleryImage} className="space-y-4 text-sm">
                <div>
                  <label className="block text-xs font-semibold text-sage-700 mb-1">Title</label>
                  <input
                    type="text"
                    required
                    placeholder="e.g. Garden Dining Table"
                    value={newGallery.title}
                    onChange={(e) => setNewGallery({ ...newGallery, title: e.target.value })}
                    className="w-full bg-earth-cream border border-sage-300 rounded-xl p-2.5 text-xs focus:outline-none"
                  />
                </div>
                <div>
                  <label className="block text-xs font-semibold text-sage-700 mb-1">Category</label>
                  <select
                    value={newGallery.category}
                    onChange={(e) => setNewGallery({ ...newGallery, category: e.target.value })}
                    className="w-full bg-earth-cream border border-sage-300 rounded-xl p-2.5 text-xs focus:outline-none"
                  >
                    <option value="ambience">Ambience & Courtyard</option>
                    <option value="food">Plated Farm Food</option>
                    <option value="drinks">Beverages & Tonics</option>
                  </select>
                </div>
                <div>
                  <label className="block text-xs font-semibold text-sage-700 mb-1">Image URL</label>
                  <input
                    type="url"
                    required
                    placeholder="https://..."
                    value={newGallery.image_url}
                    onChange={(e) => setNewGallery({ ...newGallery, image_url: e.target.value })}
                    className="w-full bg-earth-cream border border-sage-300 rounded-xl p-2.5 text-xs focus:outline-none"
                  />
                </div>
                <div>
                  <label className="block text-xs font-semibold text-sage-700 mb-1">Caption</label>
                  <textarea
                    rows={2}
                    placeholder="Atmospheric context..."
                    value={newGallery.caption}
                    onChange={(e) => setNewGallery({ ...newGallery, caption: e.target.value })}
                    className="w-full bg-earth-cream border border-sage-300 rounded-xl p-2.5 text-xs focus:outline-none"
                  />
                </div>
                <button
                  type="submit"
                  className="w-full py-2.5 rounded-xl bg-sage-800 hover:bg-sage-900 text-earth-cream text-xs font-semibold shadow-md transition-colors"
                >
                  Add to Cafe Gallery
                </button>
              </form>
            </div>

            {/* Gallery Grid */}
            <div className="lg:col-span-2 grid grid-cols-1 sm:grid-cols-2 gap-4">
              {gallery.map((img) => (
                <div key={img.id} className="bg-white rounded-2xl overflow-hidden border border-sage-200 shadow-sm flex flex-col justify-between">
                  <div className="h-44 w-full bg-sage-100 relative">
                    <img src={img.image_url} alt={img.title} className="w-full h-full object-cover" />
                    <button
                      onClick={() => handleDeleteGalleryImage(img.id)}
                      className="absolute top-2 right-2 p-1.5 rounded-full bg-black/60 text-white hover:bg-red-600 transition-colors"
                      title="Delete"
                    >
                      <Trash2 className="w-3.5 h-3.5" />
                    </button>
                  </div>
                  <div className="p-4">
                    <span className="text-[10px] uppercase font-bold text-clay-600">{img.category}</span>
                    <h5 className="font-serif font-bold text-sm text-sage-950 mt-0.5">{img.title}</h5>
                    <p className="text-xs text-sage-600 mt-1 line-clamp-1">{img.caption}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </main>
    </div>
  );
}
