# Sage Farm Cafe Environment Configuration

# 1. Admin Authentication Secret (Generate a strong random string in production)
ADMIN_SECRET_KEY=sage_farm_cafe_production_secret_key_2025_hyderabad_artisan

# 2. Database Connection (Turso Cloud libSQL / Serverless ₹0/month)
# Local fallback: defaults to file:./sage_cafe.db if left unset
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# Optional: Port configuration
PORT=3000
